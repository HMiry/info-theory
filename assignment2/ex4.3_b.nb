Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "shape", " ", "parameter", " ", "n"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "5"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Shape", " ", "parameter"}], "*)"}], "\[IndentingNewLine]", "\n", 
   
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "Gamma", " ", "distribution", " ", "PDF"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fX", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"Gamma", "[", "n", "]"}]}], ")"}], "*", 
     RowBox[{"x", "^", 
      RowBox[{"(", 
       RowBox[{"n", "-", "1"}], ")"}]}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", "x"}], "]"}], "*", 
     RowBox[{"UnitStep", "[", "x", "]"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "differential", " ", "entropy", " ", 
     "formula"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"hX", ":=", 
    RowBox[{"-", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fX", "[", "x", "]"}], "*", 
        RowBox[{"Log2", "[", 
         RowBox[{"fX", "[", "x", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "differential", " ", "entropy", " ", 
     "numerically"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"entropyResult", "=", "hX"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "numerical", " ", "result"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Differential Entropy (Numerical): \>\"", ",", 
     RowBox[{"N", "[", "entropyResult", "]"}]}], "]"}], "\n"}]}]], "Input",
