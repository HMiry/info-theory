Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", "2"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Lower", " ", "bound"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", "5"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Upper", " ", "bound"}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "Heaviside", " ", "step", " ", "function"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "x_", "]"}], ":=", 
   RowBox[{"UnitStep", "[", "x", "]"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "original", " ", "PDF", " ", "using", " ", 
    "the", " ", "Heaviside", " ", "step", " ", "function"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fX", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", "-", "a"}], "]"}], "-", 
      RowBox[{"u", "[", 
       RowBox[{"x", "-", "b"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"b", "-", "a"}], ")"}]}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "differential", " ", "entropy", " ", "formula", 
    " ", "numerically", " ", "within", " ", "the", " ", 
    RowBox[{"support", "[", 
     RowBox[{"a", ",", "b"}], "]"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hX", ":=", 
   RowBox[{"-", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fX", "[", "x", "]"}], "*", 
       RowBox[{"Log2", "[", 
        RowBox[{"fX", "[", "x", "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "a", ",", "b"}], "}"}]}], "]"}]}]}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "the", " ", "differential", " ", "entropy"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"entropyResult", "=", "hX"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Display", " ", "the", " ", "numerical", " ", "result"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Differential Entropy (Numerical): \>\"", ",", 
   RowBox[{"N", "[", "entropyResult", "]"}]}], "]"}], "\n"}], "Input",
