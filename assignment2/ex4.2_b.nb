Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "parameter", " ", "for", " ", "the", " ", 
    "exponential", " ", "distribution"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"lambda", "=", "2"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Rate", " ", "parameter"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "PDF", " ", "of", " ", "the", " ", 
     "exponential", " ", "distribution", " ", "using", " ", "Heaviside", " ", 
     "step", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fX", "[", "x_", "]"}], ":=", 
    RowBox[{"lambda", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "lambda"}], "*", "x"}], "]"}], "*", 
     RowBox[{"UnitStep", "[", "x", "]"}]}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "differential", " ", "entropy", " ", 
     "formula"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"hX", ":=", 
    RowBox[{"-", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fX", "[", "x", "]"}], "*", 
        RowBox[{"Log2", "[", 
         RowBox[{"fX", "[", "x", "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "differential", " ", "entropy", " ", 
     "numerically"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"entropyResult", "=", "hX"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "the", " ", "numerical", " ", "result"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Differential Entropy (Numerical): \>\"", ",", 
     RowBox[{"N", "[", "entropyResult", "]"}]}], "]"}], "\n"}]}]], "Input",
